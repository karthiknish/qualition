# Optional: credentials for headless / CI runs only.
# The desktop app stores logins in the OS keychain instead (Settings → Saved
# logins), which is stronger than a file. Use these only where no keychain
# exists, and never commit a filled-in copy — .env is gitignored for that reason.
QUALITION_AUTH_USERNAME=you@example.com
QUALITION_AUTH_PASSWORD=
QUALITION_AUTH_LOGIN_URL=

# Model providers (alternatively set them in Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
